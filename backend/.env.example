# ---------------------------------------------------------------------------
# CeonHub backend configuration
# Copy to .env and adjust. Never commit a real .env.
# Every variable below is read (and validated) in src/config/env.ts.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the API listens on.
PORT=4000

# Database ------------------------------------------------------------------
# PostgreSQL connection string. Matches docker-compose.yml when using Docker.
DATABASE_URL=postgresql://ceonhub:ceonhub@localhost:5432/ceonhub?schema=public

# Authentication ------------------------------------------------------------
# Minimum 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
# How long a login stays valid.
JWT_EXPIRES_IN_DAYS=7

# Session cookie ------------------------------------------------------------
# Name of the httpOnly auth cookie.
COOKIE_NAME=ceonhub_token
# Only set when the API and the site share a parent domain (e.g. .ceonhub.com).
# COOKIE_DOMAIN=
# lax | strict | none. Defaults to "lax" in development and "none" in production,
# because the deployed frontend and API usually sit on different domains.
# "none" additionally requires HTTPS (the cookie is then sent with Secure).
# COOKIE_SAMESITE=

# URLs ----------------------------------------------------------------------
# Public URL of the frontend; used in email links.
FRONTEND_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call this API with cookies.
CORS_ORIGIN=http://localhost:3000
# Public URL of this API; used to build absolute URLs for uploaded files.
API_URL=http://localhost:4000

# Sign in with LinkedIn -------------------------------------------------------
# Optional. Leave both blank and the LinkedIn buttons disappear from the sign-in
# and sign-up pages; email and password keep working.
#
# Create an app at https://www.linkedin.com/developers/apps, request the
# "Sign In with LinkedIn using OpenID Connect" product, then copy the credentials
# from the Auth tab. See README.md ("Sign in with LinkedIn") for the full steps.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
#
# Must match a Redirect URL registered on the app's Auth tab, character for
# character. Defaults to <API_URL>/api/auth/linkedin/callback when unset.
# LINKEDIN_CALLBACK_URL=http://localhost:4000/api/auth/linkedin/callback

# File storage --------------------------------------------------------------
# Only "local" ships with the MVP. See docs/architecture.md ("Storage") for how
# to add an S3-compatible driver.
STORAGE_DRIVER=local
# Directory (relative to backend/) used by the local driver.
STORAGE_LOCAL_DIR=storage
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=5

# Email ---------------------------------------------------------------------
# console = print the message to the server log (development default)
# noop    = send nothing
# See docs/architecture.md ("Email") for how to add a real provider.
EMAIL_DRIVER=console
EMAIL_FROM=CeonHub <no-reply@ceonhub.local>

# Rate limiting -------------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
# Requests per window per IP for /api/*.
RATE_LIMIT_MAX=300
# Requests per window per IP for login/register/password endpoints.
AUTH_RATE_LIMIT_MAX=20
