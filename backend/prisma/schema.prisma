// CeonHub database schema.
//
// Design notes:
// * CandidateProfile and EmployerProfile are 1:1 extensions of User and use `userId`
//   as their primary key, so "candidateId" throughout the app is always a user id.
// * Job.category is a String validated against JOB_CATEGORIES in src/utils/categories.ts
//   so the list can grow without a migration.
// * Only fields the MVP actually uses are present (see docs/implementation-plan.md).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

// Prisma 7 takes the connection URL from prisma.config.ts (CLI) and from the
// driver adapter in src/database/prisma.ts (application), not from this block.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CANDIDATE
  EMPLOYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Availability {
  AVAILABLE_NOW
  AVAILABLE_SOON
  NOT_AVAILABLE
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  TEMPORARY
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  HIDDEN
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(cuid())
  email String @unique
  /// Null for accounts that only sign in with LinkedIn.
  passwordHash String?
  /// LinkedIn's OpenID Connect subject identifier, set when an account is linked.
  linkedinId   String?    @unique
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  candidateProfile CandidateProfile?
  employerProfile  EmployerProfile?
  jobsCreated      Job[]             @relation("JobCreatedBy")
  invitationsSent  Invitation[]      @relation("InvitationEmployer")
  auditLogs        AuditLog[]        @relation("AuditActor")

  @@index([role, status])
}

model CandidateProfile {
  userId            String            @id
  name              String
  headline          String?
  bio               String?
  location          String?
  country           String?
  availability      Availability      @default(AVAILABLE_NOW)
  desiredEmployment EmploymentType?
  resumeUrl         String?
  portfolioUrl      String?
  profileVisibility ProfileVisibility @default(PUBLIC)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills       CandidateSkill[]
  resumes      Resume[]
  applications Application[]
  invitations  Invitation[]     @relation("InvitationCandidate")

  @@index([availability, profileVisibility])
  @@index([country])
}

model EmployerProfile {
  userId    String   @id
  name      String
  title     String?
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Companies & jobs
// ---------------------------------------------------------------------------

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  website     String?
  logoUrl     String?
  location    String?
  country     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employers EmployerProfile[]
  jobs      Job[]
}

model Job {
  id             String         @id @default(cuid())
  companyId      String
  createdBy      String
  title          String
  description    String
  location       String?
  remote         Boolean        @default(false)
  employmentType EmploymentType
  category       String
  compensation   String?
  currency       String?
  immediateHire  Boolean        @default(false)
  private        Boolean        @default(false)
  internship     Boolean        @default(false)
  freelance      Boolean        @default(false)
  sideIncome     Boolean        @default(false)
  status         JobStatus      @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  publishedAt    DateTime?
  expiresAt      DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator      User          @relation("JobCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  skills       JobSkill[]
  applications Application[]
  invitations  Invitation[]

  @@index([status, private, publishedAt])
  @@index([companyId, status])
  @@index([createdBy])
  @@index([category])
  @@index([employmentType])
}

// ---------------------------------------------------------------------------
// Skills
// ---------------------------------------------------------------------------

model Skill {
  id   String @id @default(cuid())
  name String
  slug String @unique

  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateSkill {
  candidateId String
  skillId     String

  candidate CandidateProfile @relation(fields: [candidateId], references: [userId], onDelete: Cascade)
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
  @@index([skillId])
}

model JobSkill {
  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
}

model Resume {
  id          String   @id @default(cuid())
  candidateId String
  fileName    String
  storageKey  String
  url         String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())

  candidate CandidateProfile @relation(fields: [candidateId], references: [userId], onDelete: Cascade)

  @@index([candidateId, createdAt])
}

// ---------------------------------------------------------------------------
// Marketplace activity
// ---------------------------------------------------------------------------

model Application {
  id          String            @id @default(cuid())
  jobId       String
  candidateId String
  coverLetter String?
  status      ApplicationStatus @default(SUBMITTED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation(fields: [candidateId], references: [userId], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([jobId, status])
}

model Invitation {
  id          String           @id @default(cuid())
  jobId       String
  employerId  String
  candidateId String
  message     String?
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employer  User             @relation("InvitationEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation("InvitationCandidate", fields: [candidateId], references: [userId], onDelete: Cascade)

  @@unique([jobId, candidateId])
  @@index([candidateId, status])
  @@index([employerId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}
