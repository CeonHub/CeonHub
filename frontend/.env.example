# ---------------------------------------------------------------------------
# CeonHub frontend configuration
# Copy to .env.local for local development. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Base URL of the CeonHub API. No trailing slash.
# Local:      http://localhost:4000
# Docker:     http://localhost:4000 (published port of the backend container)
# Production: https://api.your-domain.com
#
# NEXT_PUBLIC_ variables are embedded into the browser bundle at build time, so
# this must never contain a secret.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Absolute URL of this site. Used for SEO metadata (canonical URLs, Open Graph)
# and the sitemap. Optional in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
